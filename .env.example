# Copy to .env and fill in. .env is gitignored -- never commit real values.
#
# A REAL contact address, sent in the User-Agent on every request. This is
# functional, not cosmetic: sec.gov and ftc.gov 403 undeclared agents, and it
# is the only way a site operator can reach you instead of silently blocking
# the crawler. It lives here rather than in litfin.toml so a public repo does
# not publish somebody's mailbox; this value wins over the file.
# `litfin preflight` refuses a hosted deployment while it is a placeholder.
LITFIN_CONTACT_EMAIL=
#
# Anthropic API key for the Opus extraction stage.
ANTHROPIC_API_KEY=sk-ant-...

# CourtListener API token. Optional but strongly recommended: it raises the
# rate ceiling from 5/min, 50/hour, 125/day to 10/min, 75/hour, 300/day, and
# gives unlimited docket alerts (the free tier caps at 5).
# Get one at https://www.courtlistener.com/profile/api/
COURTLISTENER_TOKEN=

# Shared secret embedded in the webhook URL path. CourtListener webhooks carry
# NO HMAC signature, so a long random path segment plus an IP allowlist is the
# only available authentication. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LITFIN_WEBHOOK_SECRET=

# -- Hosted deployment only. Not needed for local use. -------------------
#
# Dashboard login. `litfin serve` is loopback-only and unauthenticated by
# default, which is safe on your own machine and NOT safe anywhere else. A
# non-loopback bind requires both of these to be set.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
LITFIN_WEB_USER=
LITFIN_WEB_PASSWORD=

# Signs session cookies. Rotating it logs everyone out, which is the point.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LITFIN_SESSION_SECRET=

# Digest recipients, comma-separated. Wins over
# deliver.recipient_allowlist in litfin.toml, which is committed and should
# not carry anybody's mailbox. This is an ALLOWLIST: the mailer refuses to
# send to any address not listed here, and refuses the whole send if even one
# recipient is off the list.
LITFIN_RECIPIENTS=

# SMTP, only if you turn on live digest sending (deliver.send_enabled).
# For Gmail this must be an App Password, not the account password:
#   https://myaccount.google.com/apppasswords
#   LITFIN_SMTP_HOST=smtp.gmail.com
#   LITFIN_SMTP_PORT=587
LITFIN_SMTP_HOST=
LITFIN_SMTP_PORT=587
LITFIN_SMTP_USER=
LITFIN_SMTP_PASSWORD=
LITFIN_SMTP_FROM=
